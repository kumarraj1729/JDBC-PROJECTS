package onlinefoodordering;

import java.sql.*;
import java.math.BigDecimal;
import java.util.Scanner;

public class InventoryManagementSystem {

    static final String URL =
            "jdbc:mysql://localhost:3306/inventorymanagementsystem";

    static final String USER = "root";

    static final String PASSWORD = "12345";

    static Scanner sc = new Scanner(System.in);


    // ---------------------------------------------------
    // DATABASE CONNECTION
    // ---------------------------------------------------

    static Connection connect() throws SQLException {

        return DriverManager.getConnection(
                URL, USER, PASSWORD);
    }


    // ---------------------------------------------------
    // MAIN METHOD
    // ---------------------------------------------------

    public static void main(String[] args) {

        try {

            Class.forName("com.mysql.cj.jdbc.Driver");

            while (true) {

                System.out.println(
                        "\n===== INVENTORY MANAGEMENT SYSTEM =====");

                System.out.println("1. Add Products");
                System.out.println("2. Update Stock");
                System.out.println("3. Record Sale");
                System.out.println("4. Generate Reports");
                System.out.println("5. View Products");
                System.out.println("0. Exit");

                System.out.print("Enter choice: ");

                int choice = readInt();

                try {

                    switch (choice) {

                        case 1:
                            addProducts();
                            break;

                        case 2:
                            updateStock();
                            break;

                        case 3:
                            recordSale();
                            break;

                        case 4:
                            generateReports();
                            break;

                        case 5:
                            viewProducts();
                            break;

                        case 0:
                            System.out.println(
                                    "Thank you!");
                            return;

                        default:
                            System.out.println(
                                    "Invalid choice.");
                    }

                } catch (SQLException e) {

                    System.out.println(
                            "Database Error: "
                            + e.getMessage());

                } catch (IllegalArgumentException e) {

                    System.out.println(
                            "Input Error: "
                            + e.getMessage());
                }
            }

        } catch (Exception e) {

            System.out.println(
                    "Application Error: "
                    + e.getMessage());
        }
    }


    // ---------------------------------------------------
    // READ INTEGER
    // ---------------------------------------------------

    static int readInt() {

        while (!sc.hasNextInt()) {

            System.out.print(
                    "Enter a valid number: ");

            sc.next();
        }

        int value = sc.nextInt();

        sc.nextLine();

        return value;
    }


    // ---------------------------------------------------
    // MODULE 1: ADD PRODUCTS
    // BATCH PROCESSING
    // ---------------------------------------------------

    static void addProducts()
            throws SQLException {

        System.out.println(
                "\n--- ADD PRODUCTS ---");

        System.out.print(
                "How many products do you want to add? ");

        int count = readInt();

        if (count <= 0) {

            System.out.println(
                    "Number of products must be positive.");

            return;
        }


        String sql =
                "INSERT INTO products "
                + "(product_name, supplier_id, price, stock_quantity) "
                + "VALUES (?, ?, ?, ?)";


        try (Connection con = connect();
             PreparedStatement ps =
                     con.prepareStatement(sql)) {

            /*
             * Batch processing:
             *
             * addBatch() stores multiple INSERT
             * operations.
             *
             * executeBatch() sends them to the
             * database together.
             */

            for (int i = 1; i <= count; i++) {

                System.out.println(
                        "\nProduct " + i);

                System.out.print(
                        "Product name: ");

                String name =
                        sc.nextLine().trim();

                System.out.print(
                        "Supplier ID: ");

                int supplierId = readInt();

                System.out.print(
                        "Price: ");

                BigDecimal price =
                        readAmount();

                System.out.print(
                        "Stock quantity: ");

                int quantity = readInt();


                if (name.isEmpty()
                        || supplierId <= 0
                        || price.compareTo(
                        BigDecimal.ZERO) < 0
                        || quantity < 0) {

                    throw new IllegalArgumentException(
                            "Invalid product details.");
                }


                ps.setString(1, name);
                ps.setInt(2, supplierId);
                ps.setBigDecimal(3, price);
                ps.setInt(4, quantity);

                // Add query to batch
                ps.addBatch();
            }


            // Execute all INSERT statements
            int[] result = ps.executeBatch();

            System.out.println(
                    "\nProducts added successfully.");

            System.out.println(
                    "Number of records inserted: "
                    + result.length);
        }
    }


    // ---------------------------------------------------
    // MODULE 2: UPDATE STOCK
    // ---------------------------------------------------

    static void updateStock()
            throws SQLException {

        System.out.println(
                "\n--- UPDATE STOCK ---");

        System.out.print(
                "Enter product ID: ");

        int productId = readInt();

        System.out.print(
                "Enter quantity to add: ");

        int quantity = readInt();

        if (quantity <= 0) {

            throw new IllegalArgumentException(
                    "Quantity must be greater than zero.");
        }


        String sql =
                "UPDATE products "
                + "SET stock_quantity = stock_quantity + ? "
                + "WHERE product_id = ?";


        try (Connection con = connect();
             PreparedStatement ps =
                     con.prepareStatement(sql)) {

            ps.setInt(1, quantity);
            ps.setInt(2, productId);

            int rows = ps.executeUpdate();

            if (rows == 0) {

                System.out.println(
                        "Product not found.");

            } else {

                System.out.println(
                        "Stock updated successfully.");
            }
        }
    }


    // ---------------------------------------------------
    // MODULE 3: RECORD SALE
    // TRANSACTION
    // ---------------------------------------------------

    static void recordSale()
            throws SQLException {

        System.out.println(
                "\n--- RECORD SALE ---");

        System.out.println("Enter product ID: ");
           int productId = readInt();
           
           System.out.println(" Enter quantity solid: ");
            int quantity = readInt();



        if (quantity <= 0) {

            throw new IllegalArgumentException(
                    "Quantity must be greater than zero.");
        }


        try (Connection con = connect()) {

            /*
             * Start transaction.
             */
            con.setAutoCommit(false);

            try {

                BigDecimal price;

                int currentStock;


                // Lock product row
                String selectSql =
                        "SELECT price, stock_quantity "
                        + "FROM products "
                        + "WHERE product_id = ? "
                        + "FOR UPDATE";


                try (PreparedStatement ps =
                             con.prepareStatement(selectSql)) {

                    ps.setInt(1, productId);

                    try (ResultSet rs =
                                 ps.executeQuery()) {

                        if (!rs.next()) {

                            throw new SQLException(
                                    "Product not found.");
                        }

                        price =
                                rs.getBigDecimal("price");

                        currentStock =
                                rs.getInt("stock_quantity");
                    }
                }


                // Check stock availability
                if (currentStock < quantity) {

                    throw new SQLException(
                            "Insufficient stock. "
                            + "Available stock: "
                            + currentStock);
                }


                // Reduce stock
                String updateSql =
                        "UPDATE products "
                        + "SET stock_quantity = "
                        + "stock_quantity - ? "
                        + "WHERE product_id = ?";


                try (PreparedStatement ps =
                             con.prepareStatement(updateSql)) {

                    ps.setInt(1, quantity);
                    ps.setInt(2, productId);

                    ps.executeUpdate();
                }


                // Insert sale record
                String saleSql =
                        "INSERT INTO sales "
                        + "(product_id, quantity, sale_price) "
                        + "VALUES (?, ?, ?)";


                try (PreparedStatement ps =
                             con.prepareStatement(saleSql)) {

                    ps.setInt(1, productId);
                    ps.setInt(2, quantity);
                    ps.setBigDecimal(3, price);

                    ps.executeUpdate();
                }


                /*
                 * Save both stock update and sale.
                 */
                con.commit();


                BigDecimal total =
                        price.multiply(
                                BigDecimal.valueOf(quantity));

                System.out.println(
                        "\nSale recorded successfully.");

                System.out.println(
                        "Quantity: " + quantity);

                System.out.println(
                        "Price: Rs. " + price);

                System.out.println(
                        "Total: Rs. " + total);


            } catch (SQLException e) {

                /*
                 * If anything fails,
                 * undo all changes.
                 */
                con.rollback();

                System.out.println(
                        "Sale failed.");

                System.out.println(
                        "Transaction rolled back.");

                throw e;

            } finally {

                con.setAutoCommit(true);
            }
        }
    }


    // ---------------------------------------------------
    // MODULE 4: GENERATE REPORTS
    // AGGREGATE FUNCTIONS
    // ---------------------------------------------------

    static void generateReports()
            throws SQLException {

        System.out.println(
                "\n===== SALES REPORT =====");


        // ---------------------------------------------
        // Report 1: Total sales amount
        // SUM()
        // ---------------------------------------------

        String totalSalesSql =
                "SELECT "
                + "COUNT(*) AS total_transactions, "
                + "COALESCE(SUM(quantity), 0) "
                + "AS total_items_sold, "
                + "COALESCE(SUM(quantity * sale_price), 0) "
                + "AS total_revenue "
                + "FROM sales";


        try (Connection con = connect();
             PreparedStatement ps =
                     con.prepareStatement(
                             totalSalesSql);
             ResultSet rs =
                     ps.executeQuery()) {

            if (rs.next()) {

                System.out.println(
                        "Total Transactions: "
                        + rs.getInt(
                                "total_transactions"));

                System.out.println(
                        "Total Items Sold: "
                        + rs.getInt(
                                "total_items_sold"));

                System.out.println(
                        "Total Revenue: Rs. "
                        + rs.getBigDecimal(
                                "total_revenue"));
            }
        }


        // ---------------------------------------------
        // Report 2: Product-wise sales
        // GROUP BY + SUM()
        // ---------------------------------------------

        String productReportSql =
                "SELECT p.product_name, "
                + "SUM(s.quantity) AS total_quantity, "
                + "SUM(s.quantity * s.sale_price) "
                + "AS revenue "
                + "FROM sales s "
                + "JOIN products p "
                + "ON s.product_id = p.product_id "
                + "GROUP BY p.product_id, p.product_name "
                + "ORDER BY revenue DESC";


        System.out.println(
                "\n--- PRODUCT-WISE SALES ---");


        try (Connection con = connect();
             PreparedStatement ps =
                     con.prepareStatement(
                             productReportSql);
             ResultSet rs =
                     ps.executeQuery()) {

            while (rs.next()) {

                System.out.println(
                        "Product: "
                        + rs.getString(
                                "product_name"));

                System.out.println(
                        "Quantity Sold: "
                        + rs.getInt(
                                "total_quantity"));

                System.out.println(
                        "Revenue: Rs. "
                        + rs.getBigDecimal(
                                "revenue"));

                System.out.println(
                        "----------------------");
            }
        }


        // ---------------------------------------------
        // Report 3: Average sale value
        // AVG()
        // ---------------------------------------------

        String averageSql =
                "SELECT COALESCE("
                + "AVG(quantity * sale_price), 0) "
                + "AS average_sale "
                + "FROM sales";


        try (Connection con = connect();
             PreparedStatement ps =
                     con.prepareStatement(
                             averageSql);
             ResultSet rs =
                     ps.executeQuery()) {

            if (rs.next()) {

                System.out.println(
                        "Average Sale Value: Rs. "
                        + rs.getBigDecimal(
                                "average_sale"));
            }
        }


        // ---------------------------------------------
        // Report 4: Most expensive product
        // MAX()
        // ---------------------------------------------

        String maxSql =
                "SELECT MAX(price) AS highest_price "
                + "FROM products";


        try (Connection con = connect();
             PreparedStatement ps =
                     con.prepareStatement(maxSql);
             ResultSet rs =
                     ps.executeQuery()) {

            if (rs.next()) {

                System.out.println(
                        "Highest Product Price: Rs. "
                        + rs.getBigDecimal(
                                "highest_price"));
            }
        }
    }


    // ---------------------------------------------------
    // VIEW PRODUCTS
    // ---------------------------------------------------

    static void viewProducts()
            throws SQLException {

        String sql =
                "SELECT p.product_id, "
                + "p.product_name, "
                + "s.supplier_name, "
                + "p.price, "
                + "p.stock_quantity "
                + "FROM products p "
                + "JOIN suppliers s "
                + "ON p.supplier_id = s.supplier_id "
                + "ORDER BY p.product_id";


        System.out.println(
                "\n--- PRODUCT INVENTORY ---");


        try (Connection con = connect();
             PreparedStatement ps =
                     con.prepareStatement(sql);
             ResultSet rs =
                     ps.executeQuery()) {

            while (rs.next()) {

                System.out.println(
                        "Product ID: "
                        + rs.getInt("product_id"));

                System.out.println(
                        "Product: "
                        + rs.getString(
                                "product_name"));

                System.out.println(
                        "Supplier: "
                        + rs.getString(
                                "supplier_name"));

                System.out.println(
                        "Price: Rs. "
                        + rs.getBigDecimal(
                                "price"));

                System.out.println(
                        "Stock: "
                        + rs.getInt(
                                "stock_quantity"));

                System.out.println(
                        "-------------------------");
            }
        }
    }


    // ---------------------------------------------------
    // READ AMOUNT
    // ---------------------------------------------------

    static BigDecimal readAmount() {

        while (true) {

            try {

                BigDecimal amount =
                        new BigDecimal(
                                sc.nextLine().trim());

                if (amount.compareTo(
                        BigDecimal.ZERO) < 0) {

                    throw new NumberFormatException();
                }

                return amount;

            } catch (NumberFormatException e) {

                System.out.print(
                        "Enter a valid positive amount: ");
            }
        }
    }
}
